# Your AWS / API credentials — copy .env.example to .env and fill it in. Never commit .env.
.env
# Deploy-only AWS keys, for lessons that deploy to AWS — kept apart from .env. Never commit.
.env.deploy

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenv
.venv/
venv/

# Local vector DB stores the labs may create
chroma_db/
qdrant_storage/
*.faiss
faiss_index*/

# IDE / OS — but NOT .vscode/settings.json: each lesson ships one so walkthroughs
# open in rendered markdown preview.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store

# --- NovaOps project ---
# Build artefacts: the business database, the checkpointer, and the FAISS index.
# All three are regenerated by scripts/reseed.py and scripts/ingest.py.
var/
*.db
*.sqlite3

# Packaging
*.egg-info/
build/
dist/
.ruff_cache/
