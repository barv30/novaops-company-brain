# Copy to .env and fill in. NEVER commit .env.

# --- AWS Bedrock (the model seam) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Langfuse (the submission channel) ---
# Region must match the project: cloud.langfuse.com EU or US.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP tool server ---
MCP_SERVER_URL=http://127.0.0.1:9877/mcp
MCP_HOST=127.0.0.1
MCP_PORT=9877

# --- The pinned clock ---
# Every evaluation case runs against this date. The dataset's as_of_date is 2026-07-02.
# Do not change it without a decision record entry.
NOVAOPS_AS_OF=2026-07-01
